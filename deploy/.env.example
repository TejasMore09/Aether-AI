# Copy to .env and fill in. Nothing here has a working default on purpose:
# every value that could have shipped with one is a value somebody would have
# left alone.
#
# The services refuse to start if the secrets below are still the ones printed
# in the repository, so a half-filled file fails at `docker compose up` rather
# than in six months (D60).

# ── Identity ──────────────────────────────────────────────────────────────────
# Both of these, from separate runs:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# They must differ. One signs customer sessions and one signs staff sessions,
# and sharing them would make a leaked customer token a fleet-wide credential.
AETHER_JWT_SECRET=
AETHER_STAFF_JWT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Two roles, two passwords. The owner creates and alters schema; the
# application role cannot, which is why a SQL injection in the product cannot
# drop a table. Row-level security is only enforced against a non-owner, so
# this separation is what makes tenant isolation real rather than intended.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# ── Names and certificates ────────────────────────────────────────────────────
# The customer dashboard's public hostname. Must resolve to this machine
# before the first start: Caddy asks Let's Encrypt for a certificate on boot,
# and repeated failures are rate-limited.
APP_DOMAIN=

# Where Let's Encrypt sends expiry warnings. A real mailbox somebody reads.
ACME_EMAIL=

# The staff console's hostname. Leave it as the default unless the console
# genuinely needs to be reachable from the open internet — it is the
# fleet-wide surface, and a VPN or an address allowlist is the right answer.
# The default is a .localhost name, which resolves nowhere but here.
CONSOLE_DOMAIN=console.localhost

# ── Email ─────────────────────────────────────────────────────────────────────
# Without these, password reset produces a link that reaches nobody and fault
# alerts are recorded and never sent. Both are reported as warnings at startup
# and on the console's Faults page rather than failing the deploy.
#
# The sending domain must be verified at resend.com/domains. Resend's shared
# sender only delivers to the account owner's own address, so an unverified
# domain means every customer email reports success and arrives nowhere.
AETHER_RESEND_API_KEY=
AETHER_EMAIL_FROM=
AETHER_ALERT_EMAIL=

# ── Diagnosis ─────────────────────────────────────────────────────────────────
# The provider key for the model named below. Without it the platform still
# runs: diagnosis falls back to its template path and says so.
AETHER_LLM_API_KEY=
AETHER_LLM_MODEL=gemini/gemini-3.6-flash

# ── Backups ───────────────────────────────────────────────────────────────────
# How many dumps to keep, and how often to take one. A count rather than an
# age, so a backup system that has been broken for a month cannot quietly
# delete the last good file it made.
#
# Every backup is restored into a scratch database and queried before it counts
# as a backup; the console's Faults page shows when that last succeeded. The
# dumps live in a Docker volume on this machine, which means they survive a
# dropped table and not a lost host — see the README.
AETHER_BACKUP_KEEP=14
AETHER_BACKUP_INTERVAL_HOURS=24

# ── Release ───────────────────────────────────────────────────────────────────
# The image tag to run. `latest` is convenient and is the reason nobody can
# say what is deployed; set it to a git sha for anything you would want to
# roll back.
AETHER_VERSION=latest
