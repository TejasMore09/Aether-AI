# Copy to .env and adjust. NEVER commit .env.
# Local dev values match docker-compose.yml defaults.

# App connects as aether_app (non-owner) so Row-Level Security is enforced.
AETHER_DATABASE_URL=postgresql+psycopg://aether_app:aether_app_dev_only@localhost:5433/aether
# Migrations connect as the database owner (creates tables, roles, policies).
AETHER_MIGRATION_DATABASE_URL=postgresql+psycopg://aether:aether_dev_only@localhost:5433/aether
AETHER_REDIS_URL=redis://localhost:6379/0

# JWT signing secret — generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
AETHER_JWT_SECRET=change-me-generate-a-real-secret
AETHER_JWT_TTL_MINUTES=60

AETHER_ENV=dev

# Main brain (staff console, port 8300). Distinct from AETHER_JWT_SECRET on
# purpose: a leak of the customer-facing signing key must not also hand over
# the ability to mint a staff identity with reach across the whole fleet.
AETHER_STAFF_JWT_SECRET=change-me-independently-of-the-tenant-secret
AETHER_STAFF_JWT_TTL_MINUTES=30
# Ceiling on one break-glass grant. An incident that outlives this needs a
# fresh decision with its own written reason.
AETHER_BREAK_GLASS_MAX_MINUTES=240

# ── The model provider key ────────────────────────────────────────────────────
# Paste the key here. It is passed straight to the LLM call.
#
# If this is left empty, LiteLLM falls back to looking for GEMINI_API_KEY in the
# real process environment, so an existing machine-level variable still works.
#
# Verify it is actually reaching the process rather than assuming:
#
#   cd platform && .venv/Scripts/python.exe -m aether.llm.check
#
# Getting this wrong used to fail quietly: the diagnosis layer falls back to its
# deterministic generator, so the product keeps working and every explanation is
# simply worse than it should be. That check exists so it is a five-second
# question rather than a mystery.
AETHER_LLM_API_KEY=
AETHER_LLM_MODEL=gemini/gemini-3.6-flash

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Needed for password reset (6.5) and alert delivery.
#
# LIMITATION that will bite: the shared sender onboarding@resend.dev delivers
# ONLY to the address the Resend account was created with. A password reset to
# an actual customer is silently undeliverable until a domain is verified at
# resend.com/domains and `from` becomes an address on it. Buy the domain first.

# Where a customer's browser reaches the web app. Password reset links are
# built from this and deliberately NOT from the incoming request: an attacker
# who can set the Host header would otherwise choose where a reset link
# points, and the customer would follow it. Must be the public URL in
# production, including https.
AETHER_WEB_BASE_URL=http://localhost:3000
AETHER_RESEND_API_KEY=
AETHER_EMAIL_FROM=

